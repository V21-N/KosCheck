{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/(css|js|images|favicon.png|favicon.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}