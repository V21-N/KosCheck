{
  "info": {
    "name": "KosCheck API v1",
    "description": "KosCheck Lead Generator Platform API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000/api/v1"}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {"name": "Register", "event": [{"listen": "test", "script": {"exec": ["pm.test('Has token', () => pm.response.json().data?.token)"]}}], "request": {"method": "POST", "url": "{{baseUrl}}/auth/register", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"name\":\"Test User\",\"email\":\"test@example.com\",\"password\":\"password123\",\"password_confirmation\":\"password123\",\"role\":\"mahasiswa\",\"device_name\":\"postman\"}"}}},
        {"name": "Login", "request": {"method": "POST", "url": "{{baseUrl}}/auth/login", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"test@example.com\",\"password\":\"password123\",\"device_name\":\"postman\"}"}}},
        {"name": "Me (Auth Required)", "request": {"method": "GET", "url": "{{baseUrl}}/auth/me", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}}},
        {"name": "Logout", "request": {"method": "POST", "url": "{{baseUrl}}/auth/logout", "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]}}}
      ]
    },
    {
      "name": "Public Kos",
      "item": [
        {"name": "List Kos", "request": {"method": "GET", "url": "{{baseUrl}}/public/kos"}},
        {"name": "Search Kos", "request": {"method": "GET", "url": "{{baseUrl}}/public/kos/search?q=test"}},
        {"name": "Featured Kos", "request": {"method": "GET", "url": "{{baseUrl}}/public/kos/featured"}},
        {"name": "Stats", "request": {"method": "GET", "url": "{{baseUrl}}/public/stats"}}
      ]
    },
    {
      "name": "Leads",
      "item": [
        {"name": "Track Lead", "request": {"method": "POST", "url": "{{baseUrl}}/leads", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"kos_id\":1}"}}}
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {"name": "Get Reviews", "request": {"method": "GET", "url": "{{baseUrl}}/public/kos/{slug}/reviews", "param": {"value": "slug", "description": "Kos slug"}}}
      ]
    }
  ]
}